# ─────────────────────────────────────────────────────────────────────
# DATABASE  (REQUIRED — Postgres connection string)
# ─────────────────────────────────────────────────────────────────────
# Local dev:    docker run --name frm-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
#               DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frm
# Neon (free):  https://neon.tech → create project → copy "Pooled connection"
# Vercel PG:    Vercel dashboard → Storage → Create → Postgres
#
# The pooled URL must include `?sslmode=require` for hosted providers.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require

# ─────────────────────────────────────────────────────────────────────
# AUTH  (REQUIRED in production — random 32+ char string)
# ─────────────────────────────────────────────────────────────────────
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-32-plus-char-random-string

# ─────────────────────────────────────────────────────────────────────
# APP URL  (used in invitation email links — optional)
# ─────────────────────────────────────────────────────────────────────
# On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL /
# VERCEL_URL — you only need to set APP_URL if you want to override
# (e.g. for a custom domain).
#
# Local dev:   APP_URL=http://localhost:3000
# Production:  APP_URL=https://ftrm.vercel.app
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────
# SUPER-ADMIN SEED  (only used the very first time `npm run db:seed` runs)
# ─────────────────────────────────────────────────────────────────────
# If SUPER_ADMIN_PASSWORD is left unset, the seed script will generate a
# strong random password and print it once to the deploy logs — copy it
# from there and store it somewhere safe.
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_PASSWORD=change-me-on-first-boot

# ─────────────────────────────────────────────────────────────────────
# SMTP / EMAIL  (optional — invitation emails are skipped if missing)
# ─────────────────────────────────────────────────────────────────────
# Gmail setup:
#   1. Turn on 2-Step Verification on the Google account
#      https://myaccount.google.com/security
#   2. Create a 16-character App Password
#      https://myaccount.google.com/apppasswords
#      (App: "Mail", Device: "Other -> Failure-to-Role")
#   3. Paste the 16 chars (no spaces) into SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ─────────────────────────────────────────────────────────────────────
# DL MODEL SERVICE  (optional — falls back to JS heuristics if unreachable)
# ─────────────────────────────────────────────────────────────────────
# The PyTorch microservice in dl_services/ scores resilience / failure /
# role-match. The Next.js engine calls it after each upload and blends
# 70% DL + 30% JS. If it can't be reached, it silently uses JS-only scores.
#
# Local dev:  cd dl_services && uvicorn main:app --port 8000   (default URL below)
# Vercel:     Vercel CANNOT run this Python/torch server. Host it separately
#             (Render / Railway / Fly.io / a VM) and set DL_SERVICE_URL to that
#             public https URL in the Vercel project env. Leave it unset to run
#             the deployed app on JS heuristics only.
DL_SERVICE_URL=http://localhost:8000
